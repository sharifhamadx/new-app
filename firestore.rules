rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'sharifhamadx122@gmail.com' ||
        request.auth.token.email == 'sharifhamadmoko@gmail.com'
      );
    }

    // 3. Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoURL',
          'searchesRemaining', 'isPremium', 'subscriptionPlan',
          'termsAccepted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL',
          'searchesRemaining', 'isPremium', 'subscriptionPlan',
          'termsAccepted', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() > 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.searchesRemaining is int && data.searchesRemaining >= 0 && data.searchesRemaining <= 999999
        && data.isPremium is bool
        && data.subscriptionPlan in ['free', 'weekly_pass', 'monthly', 'annual']
        && data.termsAccepted is bool && data.termsAccepted == true;
    }

    function isValidSearchItem(data, userId, searchId) {
      return data.keys().hasAll([
          'id', 'userId', 'prompt', 'region', 'mood',
          'dietary', 'language', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'prompt', 'region', 'mood',
          'dietary', 'language', 'summary', 'createdAt'
        ])
        && isValidId(data.id) && data.id == searchId
        && isValidId(data.userId) && data.userId == userId
        && data.prompt is string && data.prompt.size() <= 1000
        && data.region is string && data.region.size() <= 100
        && data.mood is string && data.mood.size() <= 100
        && data.dietary is string && data.dietary.size() <= 100
        && data.language is string && data.language.size() >= 2 && data.language.size() <= 40
        && data.summary is string && data.summary.size() <= 4000;
    }

    function isValidContactMessage(data, messageId) {
      return data.keys().hasAll(['id', 'name', 'email', 'message', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'email', 'message', 'createdAt'])
        && isValidId(data.id) && data.id == messageId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 2000;
    }

    function isValidPartnerInquiry(data, inquiryId) {
      return data.keys().hasAll([
          'id', 'businessName', 'businessType', 'city',
          'contactEmail', 'websiteUrl', 'notes', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'businessName', 'businessType', 'city',
          'contactEmail', 'websiteUrl', 'notes', 'createdAt'
        ])
        && isValidId(data.id) && data.id == inquiryId
        && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 160
        && data.businessType in ['taverna', 'hotel', 'tour']
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 100
        && data.contactEmail is string && data.contactEmail.size() >= 3 && data.contactEmail.size() <= 200
        && data.websiteUrl is string && data.websiteUrl.size() <= 300
        && data.notes is string && data.notes.size() <= 1500;
    }

    function isValidFavoriteItem(data, userId, favId) {
      return data.keys().hasAll([
          'id', 'userId', 'itemType', 'name', 'englishName', 'greekName',
          'region', 'description', 'officialWebsite', 'imageUrl', 'priceLevel', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'itemType', 'name', 'englishName', 'greekName',
          'region', 'description', 'officialWebsite', 'imageUrl', 'priceLevel', 'createdAt'
        ])
        && isValidId(data.id) && data.id == favId
        && isValidId(data.userId) && data.userId == userId
        && data.itemType in ['taverna', 'hotel', 'site', 'dish', 'gem']
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.englishName is string && data.englishName.size() <= 200
        && data.greekName is string && data.greekName.size() <= 200
        && data.region is string && data.region.size() <= 120
        && data.description is string && data.description.size() <= 1500
        && data.officialWebsite is string && data.officialWebsite.size() <= 400
        && data.imageUrl is string && data.imageUrl.size() <= 600
        && data.priceLevel is string && data.priceLevel.size() <= 20;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (incoming().isPremium == false && incoming().subscriptionPlan == 'free' && incoming().searchesRemaining == 2)
        );

      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['searchesRemaining', 'updatedAt']) &&
            incoming().searchesRemaining == existing().searchesRemaining - 1 &&
            incoming().searchesRemaining >= 0
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['isPremium', 'subscriptionPlan', 'searchesRemaining', 'updatedAt']) &&
            incoming().isPremium == true &&
            incoming().subscriptionPlan in ['weekly_pass', 'monthly', 'annual'] &&
            incoming().searchesRemaining == 999999
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'termsAccepted', 'updatedAt'])
          )
        );

      match /searches/{searchId} {
        allow get: if isValidId(userId) && isValidId(searchId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.userId == userId;
        allow create: if isValidId(userId)
          && isValidId(searchId)
          && isOwner(userId)
          && isValidSearchItem(incoming(), userId, searchId)
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(searchId) && (isOwner(userId) || isAdmin());
      }

      match /favorites/{favId} {
        allow get: if isValidId(userId) && isValidId(favId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin()) && resource.data.userId == userId;
        allow create: if isValidId(userId)
          && isValidId(favId)
          && isOwner(userId)
          && isValidFavoriteItem(incoming(), userId, favId)
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time;
        allow delete: if isValidId(userId) && isValidId(favId) && (isOwner(userId) || isAdmin());
      }
    }

    match /contactMessages/{messageId} {
      allow create: if isValidId(messageId)
        && isValidContactMessage(incoming(), messageId)
        && incoming().createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    match /partnerInquiries/{inquiryId} {
      allow create: if isValidId(inquiryId)
        && isValidPartnerInquiry(incoming(), inquiryId)
        && incoming().createdAt == request.time;
      allow read, delete: if isAdmin();
    }
  }
}
