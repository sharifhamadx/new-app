# Server-side Gemini API key (required for AI recommendations, itinerary, translation, and TTS)
GEMINI_API_KEY=

# Optional server-side Admin passcode (recommended when deploying; otherwise claim once in the in-app Admin setup)
ADMIN_PASSCODE=

# Optional server-side WhatsApp support number (digits only with country code, never exposed in frontend code)
SUPPORT_WHATSAPP=
