# Server-side Gemini API key (required for AI recommendations, itinerary, translation, and TTS)
GEMINI_API_KEY=

# Server port (AI Studio uses port 3000)
PORT=3000

# Firebase Web API key (configured via firebase-applet-config.json)
FIREBASE_API_KEY=

# Optional API base URL override for native/external clients
VITE_API_BASE_URL=
